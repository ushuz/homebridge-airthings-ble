{
  "name": "@ushuz/homebridge-airthings-ble",
  "displayName": "Homebridge Airthings BLE",
  "type": "module",
  "version": "1.0.1",
  "description": "Homebridge plugin for Airthings air quality monitors over Bluetooth LE",
  "author": "ushuz",
  "license": "MIT",
  "homepage": "https://github.com/ushuz/homebridge-airthings-ble#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ushuz/homebridge-airthings-ble.git"
  },
  "bugs": {
    "url": "https://github.com/ushuz/homebridge-airthings-ble/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "airthings",
    "ble",
    "bluetooth",
    "radon",
    "wave",
    "air quality"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^20.18.0 || ^22",
    "homebridge": "^1.8.5 || ^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.7.1",
    "cbor": "^10.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.21.0",
    "homebridge": "^1.8.5",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
